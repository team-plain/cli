{
	"name": "@team-plain/cli",
	"private": false,
	"version": "1.0.1",
	"description": "CLI for interacting with the Plain API",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/team-plain/cli.git"
	},
	"type": "module",
	"bin": {
		"plain": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check --write .",
		"test": "pnpm build && node --test test/*.test.ts",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/cli": "^3.0.3",
		"@size-limit/file": "^14.1.0",
		"@types/node": "^22.20.4",
		"publint": "^0.3.24",
		"size-limit": "^14.1.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@team-plain/graphql": "^3.2.0"
	},
	"packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
