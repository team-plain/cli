{
	"name": "@team-plain/cli",
	"private": false,
	"version": "1.0.2",
	"description": "CLI for interacting with the Plain API",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/team-plain/cli.git"
	},
	"type": "module",
	"bin": {
		"plain": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check --write .",
		"test": "pnpm build && node --test test/*.test.ts",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@changesets/cli": "^3.0.3",
		"@size-limit/file": "^14.2.0",
		"@types/node": "^22.20.5",
		"publint": "^0.3.25",
		"size-limit": "^14.2.0",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@team-plain/graphql": "^3.2.0"
	},
	"packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5"
}
