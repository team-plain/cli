{
	"autoReview": ["open", "push"],
	"autoApprove": {
		"enabled": true,
		"riskCeiling": "low",
		"filters": {
			"includePaths": ["**/*.md", "test/**"],
			"excludePaths": [
				"**/.greptile/**",
				"**/CLAUDE.md",
				"**/AGENTS.md",
				".github/**",
				"package.json",
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml",
				".nvmrc",
				".changeset/**",
				"CHANGELOG.md"
			]
		}
	}
}
